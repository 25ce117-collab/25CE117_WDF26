# Disable PHP and script execution in upload directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar|sh|pl|cgi|exe)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>
